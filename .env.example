# 사용할 프로바이더의 키만 채우면 됩니다. 없는 프로바이더 호출 시 안내 메시지가 반환됩니다.
# 사내 로컬 Ollama (OpenAI 호환). 키는 아무 문자열이나 넣으면 됩니다(Ollama는 검사 안 함).
# Docker로 띄울 땐 OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:31b-mlx
# (선택) thinking 서버 기본값: none(빠름) | low | medium | high. 비우면 Ollama 기본(ON). 요청 body의 reasoning_effort가 우선.
OLLAMA_REASONING_EFFORT=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
# 보호 설정 (설정 시에만 활성화)
DOCS_USER=
DOCS_PASSWORD=
GATEWAY_API_KEY=
PORT=3000
# (선택) JSON 요청 본문 한도. 기본 2mb
BODY_LIMIT=
# (선택) 업스트림 응답 대기 한도(ms). 기본 900000(15분)
UPSTREAM_TIMEOUT_MS=
